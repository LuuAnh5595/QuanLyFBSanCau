{
  "name": "quan-ly-fb-san-cau-backend",
  "version": "1.0.0",
  "description": "Backend Cloudflare Worker cho Hệ thống AI Quản lý & Tự động Đăng bài Facebook Fanpage Sân Cầu",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute fb-san-cau-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute fb-san-cau-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.0"
  }
}
